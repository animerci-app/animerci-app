rules_version = '2';
// AniMerci — règles de sécurité Firestore
// Principe : chacun ne voit que le strict nécessaire (minimisation RGPD).
//  - admin        (administratrice) : tout
//  - intervenant  : lit les activités ; lit les inscriptions et séances de SES activités ;
//                   peut enregistrer un appel mais PAS le valider
//  - benevole     : lit uniquement les activités (planning)
//  - partenaire   : (accès ouvert par l'administratrice, p. ex. pour un essai) lit et saisit SES propres échanges, rien d'autre
//  - matériel (v1.17.0, accès à cocher depuis la v1.20.0) : l'administratrice, et les intervenant·es et bénévoles dont l'accès est coché, lisent et saisissent le matériel, les emprunts et les mouvements de stock ; seule l'administratrice supprime
//  - portage (v1.19.0, accès à cocher depuis la v1.20.0) : l'administratrice, et les intervenant·es et bénévoles dont l'accès est coché, lisent et saisissent le suivi des bénéficiaires du portage de repas et les échanges avec le prestataire ; seule l'administratrice supprime
//  - accès provisoires (v1.20.0) : l'administratrice coche, par compte intervenant·e ou bénévole, Matériel, Portage de repas ou (bénévoles seulement) Saisie des inscriptions, avec une date de fin facultative (champs acces et accesFin du profil).
//                   Sans case cochée, ces rôles gardent leurs droits d'origine (planning ; activités et appels pour les intervenant·es).
//  - accueils (v1.20.0) : jeunes adultes (bourse), services civiques, stagiaires : administratrice uniquement
//  - budgets et régie (v1.21.0, accès « budgets » à cocher) : l'administratrice, et les intervenant·es et bénévoles dont l'accès est coché, lisent et saisissent les dépenses et les opérations de régie ; seule l'administratrice supprime et règle le montant initial de chaque budget
//  - questionnaires et voyages (v1.22.0) : questionnaires et sondages, réponses reçues, bibliothèque des voyages et sorties : administratrice uniquement (aucun accès équipe)
// Les comptes et leurs rôles (collection "users") sont créés dans la console Firebase.
service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() { return request.auth != null; }
    function profil() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function aProfil() { return connecte() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function role() { return aProfil() ? profil().role : ''; }
    function estAdmin() { return role() == 'admin'; }
    function activitesAutorisees() { return aProfil() && 'activites' in profil() ? profil().activites : []; }
    function sienne(activiteId) { return role() == 'intervenant' && activiteId in activitesAutorisees(); }
    // Accès provisoires (v1.20.0) : case cochée par l'administratrice sur le profil, et date de fin (AAAAMMJJ, 0 = sans date) non dépassée. Le jour est celui du serveur (UTC).
    function dateDuJour() { return request.time.year() * 10000 + request.time.month() * 100 + request.time.day(); }
    function acces(m) {
      return aProfil() && role() in ['intervenant', 'benevole'] && 'acces' in profil() && profil().acces.get(m, false) == true
        && (!('accesFin' in profil()) || profil().accesFin == 0 || profil().accesFin >= dateDuJour());
    }
    function accesInscriptions() { return role() == 'benevole' && acces('inscriptions'); }

    // Profil : chacun lit le sien ; seul l'admin lit/écrit les autres.
    match /users/{uid} {
      allow read: if connecte() && (request.auth.uid == uid || estAdmin());
      allow write: if estAdmin() && request.auth.uid != uid;
    }

    // Personnes (seniors) : réservé à l'admin
    match /seniors/{id} { allow read, write: if estAdmin(); }

    // Activités : lecture pour tout rôle connu, écriture admin
    match /activites/{id} {
      allow read: if role() in ['admin', 'intervenant', 'benevole'];
      allow write: if estAdmin();
    }

    // Inscriptions : lecture intervenant limitée à ses activités (la requête doit filtrer sur activiteId)
    match /inscriptions/{id} {
      allow read: if estAdmin() || sienne(resource.data.activiteId) || accesInscriptions();
      // Saisie d'une inscription reçue sur papier ou par téléphone (bénévole coché) : création seulement, statut « inscrit » ou « en attente » ; ni modification ni suppression
      allow create: if estAdmin() || (accesInscriptions() && request.resource.data.statut in ['inscrit', 'attente'] && request.resource.data.keys().hasAll(['activiteId', 'seniorId', 'par']));
      allow update, delete: if estAdmin();
    }

    // Personnes, version restreinte (v1.20.0) : nom, prénom, nom de jeune fille, statut, année de naissance, années de cotisation réglées. Ni téléphone, ni adresse, ni date de naissance complète.
    // Recopiée par l'administratrice à l'ouverture de « Personnes » ; lue par les bénévoles dont l'accès « Saisie des inscriptions » est coché.
    match /seniorsLite/{id} {
      allow read: if estAdmin() || accesInscriptions();
      allow write: if estAdmin();
    }

    // Accueils (v1.20.0) : jeunes adultes (bourse), services civiques, stagiaires. Aucune donnée de santé. Administratrice uniquement.
    match /accueils/{id} { allow read, write: if estAdmin(); }

    // Séances / appels : l'intervenant enregistre mais ne valide pas
    match /seances/{id} {
      allow read: if estAdmin() || sienne(resource.data.activiteId);
      allow create: if estAdmin()
        || (sienne(request.resource.data.activiteId) && request.resource.data.valide != true);
      allow update: if estAdmin()
        || (sienne(resource.data.activiteId)
            && resource.data.valide != true
            && request.resource.data.valide != true
            && request.resource.data.activiteId == resource.data.activiteId);
      allow delete: if estAdmin();
    }

    // Fiches de sortie (personne à prévenir, autorisations, informations pratiques ; aucune donnée de santé) et tâches : admin uniquement
    match /fiches/{id} { allow read, write: if estAdmin(); }
    match /taches/{id} { allow read, write: if estAdmin(); }

    // Corbeille (30 jours) : admin uniquement
    match /corbeille/{id} { allow read, write: if estAdmin(); }

    // Annuaire (intervenants, partenaires, bénévoles, collègues : coordonnées) : administratrice uniquement
    match /contacts/{id} { allow read, write: if estAdmin(); }

    // Partenaires (v1.16.0) : journal des échanges (appels, courriels, réunions…) et conventions. Aucune donnée de santé.
    // Administratrice uniquement pour l'instant ; chaque échange porte le champ « par » (qui l'a saisi) : ouvrir la saisie à l'équipe se fera ici, sans refaire les données.
    // Un compte « partenaire » ne lit que les échanges qu'il a saisis (champ parUid) et ne peut ni les supprimer ni les rattacher à un autre partenaire.
    function monEchange(d) { return role() == 'partenaire' && d.parUid == request.auth.uid && d.partenaireId == profil().partenaireId && d.interne != true; }
    match /echanges/{id} {
      allow read: if estAdmin() || (role() == 'partenaire' && resource.data.parUid == request.auth.uid);
      allow create: if estAdmin() || monEchange(request.resource.data);
      allow update: if estAdmin() || (monEchange(resource.data) && monEchange(request.resource.data));
      allow delete: if estAdmin();
    }
    match /conventions/{id} { allow read, write: if estAdmin(); }

    // Matériel, réserves, caisses de décorations, emprunts et mouvements de stock (v1.17.0). Aucune donnée de santé, aucune photo.
    // Toute l'équipe (admin, intervenant, bénévole) lit, crée et modifie : chaque ligne garde « saisi par ». Seule l'administratrice supprime (la corbeille est réservée à l'admin).
    // Le partenaire n'y a pas accès. Les mouvements de stock ne se modifient pas (historique).
    function equipeMateriel() { return estAdmin() || acces('materiel'); }
    match /materiel/{id} {
      allow read, create, update: if equipeMateriel();
      allow delete: if estAdmin();
    }
    match /emprunts/{id} {
      allow read, create, update: if equipeMateriel();
      allow delete: if estAdmin();
    }
    match /mouvements/{id} {
      allow read, create: if equipeMateriel();
      allow update: if false;
      allow delete: if estAdmin();
    }

    // Portage de repas (v1.19.0). Aucune donnée de santé : motifs d'organisation seulement.
    // Le document « portage » d'un bénéficiaire recopie le strict nécessaire de sa fiche (nom, sexe, année de naissance, jours de livraison) et son historique (début, interruptions, reprises, arrêt) :
    // l'équipe lit, crée et modifie (chaque événement garde « saisi par »), seule l'administratrice supprime. Le partenaire n'y a pas accès.
    function equipePortage() { return estAdmin() || acces('portage'); }
    match /portage/{id} {
      allow read, create, update: if equipePortage();
      allow delete: if estAdmin();
    }
    match /portageEchanges/{id} {
      allow read, create, update: if equipePortage();
      allow delete: if estAdmin();
    }
    // Journal de suivi du portage (cahier §9.3, lot B second temps, v1.24.0) : mêmes accès que le reste du Portage. Aucune donnée de santé.
    match /portageJournal/{id} {
      allow read, create, update: if equipePortage();
      allow delete: if estAdmin();
    }

    // Lien social (cahier §10, lot B second temps, v1.24.0) : administratrice seule, sans aucune exception (contrairement au reste du Portage), car il touche aux fiches complètes des personnes. Aucune donnée de santé.
    match /lienSocial/{id} { allow read, write: if estAdmin(); }

    // Résidence (nouveau lot, v1.25.0, cahier §11, §22, §23) : personnel et remplacements, relations familles, relations résidents, journal de transmissions,
    // temps de remplacement, interventions exceptionnelles. Aucune donnée de santé : organisation du service uniquement (le module « personnel » n'est pas un dossier RH).
    // L'équipe (admin, et intervenant·es/bénévoles dont l'accès « Résidence » est coché, avec date de fin facultative) lit, crée et modifie ; chaque ligne garde « par ».
    // Seule l'administratrice supprime. Accès délégable en cas d'urgence, sans jamais partager le compte de l'administratrice (voir acces() ci-dessus, même mécanisme que Matériel, Portage, Budgets).
    function equipeResidence() { return estAdmin() || acces('residence'); }
    match /residencePersonnel/{id} {
      allow read, create, update: if equipeResidence();
      allow delete: if estAdmin();
    }
    match /residenceFamilles/{id} {
      allow read, create, update: if equipeResidence();
      allow delete: if estAdmin();
    }
    match /residenceResidents/{id} {
      allow read, create, update: if equipeResidence();
      allow delete: if estAdmin();
    }
    match /residenceJournal/{id} {
      allow read, create, update: if equipeResidence();
      allow delete: if estAdmin();
    }
    match /residenceRemplacements/{id} {
      allow read, create, update: if equipeResidence();
      allow delete: if estAdmin();
    }
    match /residenceInterventions/{id} {
      allow read, create, update: if equipeResidence();
      allow delete: if estAdmin();
    }

    // Budgets, dépenses et régie (lot D, v1.21.0). Suivi interne (ne remplace pas le logiciel comptable officiel) : aucune donnée de santé.
    // L'équipe (admin, et intervenant·es/bénévoles dont l'accès « Budgets et régie » est coché) lit, crée et modifie ; chaque ligne garde « par ». Seule l'administratrice supprime.
    // Le montant initial de chaque budget est un document de la collection « parametres » (id « budgets-<année> ») : lecture équipe, écriture admin seule (cf. règle /parametres ci-dessous).
    function equipeBudgets() { return estAdmin() || acces('budgets'); }
    match /depenses/{id} {
      allow read, create, update: if equipeBudgets();
      allow delete: if estAdmin();
    }
    match /regie/{id} {
      allow read, create, update: if equipeBudgets();
      allow delete: if estAdmin();
    }

    // Questionnaires et sondages, réponses reçues, bibliothèque des voyages et sorties (v1.22.0) : administratrice uniquement, aucun accès équipe.
    match /questionnaires/{id} { allow read, write: if estAdmin(); }
    match /reponsesQuestionnaire/{id} { allow read, write: if estAdmin(); }
    match /voyages/{id} { allow read, write: if estAdmin(); }

    // Paramètres de l'outil (noms, listes, durées, modules) : lisibles par tout rôle connu, modifiables par l'admin seule
    match /parametres/{id} {
      allow read: if role() in ['admin', 'intervenant', 'benevole', 'partenaire'];
      allow write: if estAdmin();
    }

    // Journal des modifications : tout rôle connu peut y ajouter une ligne, seule l'admin le lit et le nettoie
    match /journal/{id} {
      allow create: if role() in ['admin', 'intervenant', 'benevole', 'partenaire'];
      allow read, delete: if estAdmin();
      allow update: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
